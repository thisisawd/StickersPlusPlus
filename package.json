{
  "name": "stickers-plus-plus",
  "version": "1.0.0",
  "description": "AI-powered stickers for educators — create custom sticker sets with Copilot to grade assignments in OneNote.",
  "author": "Stickers++",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",
    "dev": "webpack serve --mode development --config webpack.config.js --open",
    "lint": "eslint src/",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.89"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.48.0",
    "css-loader": "^7.1.2",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "office-addin-debugging": "^5.1.4",
    "office-addin-dev-certs": "^2.0.6",
    "office-addin-manifest": "^1.13.4",
    "pngjs": "^7.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
