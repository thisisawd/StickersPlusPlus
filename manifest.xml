<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>9.0.0.0</Version>
  <ProviderName>Stickers++</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Stickers++" />
  <Description DefaultValue="AI-powered stickers for educators. Generate custom sticker sets to use when grading assignments in OneNote." />
  <IconUrl DefaultValue="https://thisisawd.github.io/StickersPlusPlus/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://thisisawd.github.io/StickersPlusPlus/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://thisisawd.github.io/StickersPlusPlus/" />

  <AppDomains>
    <AppDomain>https://thisisawd.github.io</AppDomain>
    <AppDomain>https://FHL-2026.cognitiveservices.azure.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Notebook" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://thisisawd.github.io/StickersPlusPlus/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Notebook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="StickersGroup">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="StickersButton">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>StickersTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://thisisawd.github.io/StickersPlusPlus/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://thisisawd.github.io/StickersPlusPlus/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://thisisawd.github.io/StickersPlusPlus/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://thisisawd.github.io/StickersPlusPlus/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://thisisawd.github.io/StickersPlusPlus/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Stickers++" />
        <bt:String id="Group.Label" DefaultValue="Stickers++" />
        <bt:String id="Button.Label" DefaultValue="Stickers++" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Generate custom sticker sets for grading assignments." />
        <bt:String id="Button.Tooltip" DefaultValue="Open Stickers++ to create and insert stickers" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>


